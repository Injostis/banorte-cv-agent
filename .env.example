# Copia este archivo a ".env" (sin ".example") y pon tus valores reales.
# ".env" nunca se sube a git (está en .gitignore).

ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui

# Token que la plataforma de Banorte debe mandar como "Authorization: Bearer <valor>".
# Genera uno propio, largo y aleatorio -- no uses un valor de ejemplo real.
AGENT_BEARER_TOKEN=genera-un-token-largo-y-aleatorio-aqui

# Opcional, valores por defecto ya sensatos:
# CLAUDE_MODEL=claude-sonnet-5
# LOG_LEVEL=INFO

# Observabilidad con Langfuse -- opcional. Sin estas dos llaves, el agente
# sigue funcionando exactamente igual, solo sin trazas.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
